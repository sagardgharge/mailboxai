# Copy to .env and fill in. Never commit a real token.
# WhatsApp Cloud API (Meta developers dashboard)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=mailboxai-verify
WHATSAPP_APP_SECRET=
# Muse Spark via the Meta Model API
META_MODEL_API_BASE_URL=
META_MODEL_API_KEY=
META_MODEL_NAME=muse-spark-1.3
# Fireworks junk filter (optional)
# Copy FIREWORKS_MODEL exactly from the Fireworks model catalogue.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
# SAM 3.1 hosted endpoint (optional)
SAM_API_URL=
# Smarty (USPS-based) address validation, for business address checks
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
# Database file (SQLite)
MAILBOXAI_DB=mailboxai.db
# Local demo only — NEVER 1 in production
MAILBOXAI_MOCK_VERIFY=0
# Dev mode: business-register responses include the postcard PIN — NEVER 1 in production
MAILBOXAI_DEV=0
# Admin key: whoever holds this key is the MailboxAI admin (the service owner)
MAILBOXAI_ADMIN_KEY=choose-a-secret-admin-key
# Voice notes: macOS speech + ffmpeg to ogg/opus (leave blank = text fallback)
TTS_COMMAND=say -o {out}.aiff "{text}" && ffmpeg -y -v error -i {out}.aiff -c:a libopus {out} && rm {out}.aiff
